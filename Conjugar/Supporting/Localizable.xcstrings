    "Onboarding.modelsBody" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discover the conjugation models that Spanish verbs follow. Each model captures a distinct pattern of stem changes and endings, from the regular -ar, -er, and -ir verbs to irregulars like tener and ir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubre los modelos de conjugación que siguen los verbos en español. Cada modelo recoge un patrón distinto de cambios en la raíz y de terminaciones, desde los verbos regulares en -ar, -er e -ir hasta irregulares como tener e ir."
          }
        }
      }
    },
