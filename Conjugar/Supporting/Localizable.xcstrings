    "Game.settingsDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conjugar has a built-in, family-friendly game called Toreo por Amor. As a plucky flamenco dancer, climb the girders to reach the bull and rescue the matador. Climb five escalating stages, dodging rolling hazards and grabbing power-ups. Survive surprises along the way. Reach the top of the final stage, and a flamenco dance-off with the bull determines whether love conquers all."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conjugar tiene un juego integrado y apto para toda la familia llamado Toreo por Amor. Como una intrépida bailaora de flamenco, sube por las vigas hasta llegar al toro y rescata al matador. Sube por cinco niveles cada vez más difíciles, esquivando obstáculos y recogiendo mejoras. Sobrevive a las sorpresas del camino. Llega a la cima del nivel final, y un duelo de flamenco con el toro determina si el amor todo lo vence."
          }
        }
      }
    },
    "Game.stompMove" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stomp"
